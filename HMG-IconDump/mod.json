{
  "id": "hmg-k5-firmware-dump",
  "name": "HMG K5 Firmware Dump",
  "version": "1.0.0-rc.1",
  "hmgapi": ">=1.1.0-rc.3",
  "authors": [
    "Nyx-Asteria"
  ],
  "license": "MIT",
  "description": "Read-only stock radio, automotive framework and audio routing file collector for offline K5 analysis.",
