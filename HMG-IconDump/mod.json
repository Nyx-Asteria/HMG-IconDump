{
  "id": "hmg-k5-firmware-dump",
  "name": "HMG K5 Firmware Dump",
  "version": "1.0.0-rc.4",
  "hmgapi": ">=1.1.0-rc.3",
  "authors": [
    "Nyx-Asteria"
  ],
  "license": "MIT",
  "description": "Incremental read-only K5 navigation engine and iAP2 server collector.",
  "services": [
    {
      "name": "firmware-dump",
      "jar": "firmware-dump.jar",
      "class": "dev.hmg.icondump.IconDump",
      "user": "system",
      "start": "android",
      "restart": true
    }
  ],
  "usb": [
    "HMGAPI/K5FirmwareDump"
  ],
  "live": true
}
